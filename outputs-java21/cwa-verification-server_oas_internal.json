          "keyType" : {
            "$ref" : "#/components/schemas/RegistrationTokenKeyType"
          },
          "key" : {
            "type" : "string"
          }
        },
        "description" : "The registration token request model.",
        "deprecated" : false
      },
      "InternalTestResult" : {
        "description" : "The test result model for internal test result requests.",
        "allOf" : [ {
          "$ref" : "#/components/schemas/TestResult"
        }, {
          "type" : "object",
          "properties" : {
            "testId" : {
              "type" : "string"
            }
          },
          "description" : "The test result model for internal test result requests.",
          "deprecated" : false
        } ]
      }
