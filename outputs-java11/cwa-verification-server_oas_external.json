        "type" : "object",
        "properties" : {
          "tan" : {
            "pattern" : "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$",
            "type" : "string"
          },
          "responsePadding" : {
            "type" : "string"
          }
        },
        "description" : "The transaction number model.",
        "deprecated" : false
      },
      "RegistrationTokenKeyType" : {
        "type" : "string",
        "enum" : [ "GUID", "TELETAN" ]
      },
      "RegistrationToken" : {
        "required" : [ "registrationToken" ],
        "type" : "object",
        "properties" : {
          "registrationToken" : {
            "pattern" : "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$",
            "type" : "string"
          },
          "responsePadding" : {
            "type" : "string"
          }
        },
        "description" : "The registration token model.",
        "deprecated" : false
      },
      "TestResult" : {
        "required" : [ "sc", "testResult" ],
        "type" : "object",
        "properties" : {
          "sc" : {
            "type" : "integer",
            "format" : "int64"
          },
          "labId" : {
            "type" : "string"
          },
          "testResult" : {
            "type" : "integer",
            "format" : "int32"
          },
          "responsePadding" : {
            "type" : "string"
          }
        },
        "description" : "The test result model.",
        "deprecated" : false
      },
      "RegistrationTokenRequest" : {
        "required" : [ "key", "keyType" ],
        "type" : "object",
        "properties" : {
          "keyDob" : {
            "pattern" : "^[XxA-Fa-f0-9]([A-Fa-f0-9]{63})$",
            "type" : "string"
          },
          "keyType" : {
            "$ref" : "#/components/schemas/RegistrationTokenKeyType"
          },
          "key" : {
            "type" : "string"
          }
        },
        "description" : "The registration token request model.",
        "deprecated" : false
      }
    }
